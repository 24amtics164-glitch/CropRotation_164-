@model CropRotation_164.Models.Crop
@{
    ViewData["Title"] = "Delete Crop";
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="card shadow-sm border-0 border-top border-4 border-danger bg-white">
                <div class="card-header bg-danger text-white py-3">
                    <h4 class="mb-0 fw-bold">⚠ Confirm Crop Deletion</h4>
                </div>
                <div class="card-body p-4">
                    <div class="alert alert-warning mb-4" role="alert">
                        <strong>Warning:</strong> You are about to permanently remove this crop variety from the master database.
                    </div>

                    <div class="card bg-light border-0 p-3 mb-4">
                        <dl class="row mb-0">
                            <dt class="col-sm-4 text-muted">Crop Name:</dt>
                            <dd class="col-sm-8 fw-bold fs-5 text-danger">@Model.CropName</dd>

                            <dt class="col-sm-4 text-muted">Botanical Family:</dt>
                            <dd class="col-sm-8">@Model.Family</dd>

                            <dt class="col-sm-4 text-muted">Season:</dt>
                            <dd class="col-sm-8">@Model.Season</dd>

                            <dt class="col-sm-4 text-muted">Nutrient Role:</dt>
                            <dd class="col-sm-8">@Model.NutrientDemand</dd>

                            <dt class="col-sm-4 text-muted">Duration:</dt>
                            <dd class="col-sm-8">@Model.DurationInDays Days</dd>
                        </dl>
                    </div>

                    <form asp-action="Delete" method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" asp-for="Id" />
                        <div class="d-flex justify-content-between align-items-center">
                            <button type="submit" class="btn btn-danger px-4 fw-bold">Yes, Delete Crop</button>
                            <a asp-action="Index" class="btn btn-outline-secondary">Cancel &amp; Return</a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
