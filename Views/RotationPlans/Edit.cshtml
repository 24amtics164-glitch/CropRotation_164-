@model CropRotation_164.Models.RotationPlan
@{
    ViewData["Title"] = "Edit Crop Rotation Cycle";
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-lg-9">
            <div class="card shadow-sm border-0 bg-white">
                <div class="card-header bg-warning text-dark py-3">
                    <h4 class="mb-0 fw-bold">✎ Modify Crop Rotation Cycle #@Model.Id</h4>
                </div>
                <div class="card-body p-4">
                    <form asp-action="Edit" method="post" novalidate>
                        @Html.AntiForgeryToken()
                        <input type="hidden" asp-for="Id" />
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

                        <!-- Field Plot & Crop Row -->
                        <div class="row g-3 mb-3">
                            <div class="col-md-6">
                                <label asp-for="FieldId" class="form-label fw-bold"></label>
                                <select asp-for="FieldId" asp-items="ViewBag.FieldId" class="form-select"></select>
                                <span asp-validation-for="FieldId" class="text-danger small"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="CropId" class="form-label fw-bold"></label>
                                <select asp-for="CropId" asp-items="ViewBag.CropId" class="form-select"></select>
                                <span asp-validation-for="CropId" class="text-danger small"></span>
                            </div>
                        </div>

                        <!-- Season Year & Cycle Status Row -->
                        <div class="row g-3 mb-3">
                            <div class="col-md-6">
                                <label asp-for="SeasonYear" class="form-label fw-bold"></label>
                                <input asp-for="SeasonYear" class="form-control" />
                                <span asp-validation-for="SeasonYear" class="text-danger small"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="Status" class="form-label fw-bold"></label>
                                <select asp-for="Status" class="form-select">
                                    <option value="Planned">Planned</option>
                                    <option value="In Progress">In Progress</option>
                                    <option value="Harvested">Harvested</option>
                                    <option value="Rotated">Rotated</option>
                                </select>
                                <span asp-validation-for="Status" class="text-danger small"></span>
                            </div>
                        </div>

                        <!-- Planting Date & Harvest Date Row -->
                        <div class="row g-3 mb-3">
                            <div class="col-md-6">
                                <label asp-for="PlantingDate" class="form-label fw-bold"></label>
                                <input asp-for="PlantingDate" type="date" class="form-control" />
                                <span asp-validation-for="PlantingDate" class="text-danger small"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="ExpectedHarvestDate" class="form-label fw-bold"></label>
                                <input asp-for="ExpectedHarvestDate" type="date" class="form-control" />
                                <span asp-validation-for="ExpectedHarvestDate" class="text-danger small"></span>
                            </div>
                        </div>

                        <!-- Soil Condition Prior & Recommended Fertilizer Row -->
                        <div class="row g-3 mb-3">
                            <div class="col-md-6">
                                <label asp-for="SoilConditionBefore" class="form-label fw-bold"></label>
                                <input asp-for="SoilConditionBefore" class="form-control" />
                                <span asp-validation-for="SoilConditionBefore" class="text-danger small"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="RecommendedFertilizer" class="form-label fw-bold"></label>
                                <input asp-for="RecommendedFertilizer" class="form-control" />
                                <span asp-validation-for="RecommendedFertilizer" class="text-danger small"></span>
                            </div>
                        </div>

                        <!-- Rotation Benefit Score -->
                        <div class="mb-4">
                            <label asp-for="RotationBenefitScore" class="form-label fw-bold"></label>
                            <input asp-for="RotationBenefitScore" type="number" min="0" max="100" class="form-control" />
                            <span asp-validation-for="RotationBenefitScore" class="text-danger small"></span>
                        </div>

                        <!-- Buttons -->
                        <div class="d-flex justify-content-between align-items-center">
                            <button type="submit" class="btn btn-warning px-4 fw-bold">Update Rotation Cycle</button>
                            <a asp-action="Index" class="btn btn-outline-secondary">Back to Cycles List</a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
