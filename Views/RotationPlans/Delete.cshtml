@model CropRotation_164.Models.RotationPlan
@{
    ViewData["Title"] = "Delete Rotation Cycle";
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="card shadow-sm border-0 border-top border-4 border-danger bg-white">
                <div class="card-header bg-danger text-white py-3">
                    <h4 class="mb-0 fw-bold">⚠ Confirm Rotation Cycle Deletion</h4>
                </div>
                <div class="card-body p-4">
                    <div class="alert alert-warning mb-4" role="alert">
                        <strong>Warning:</strong> You are about to remove this crop rotation record. Historical succession tracking for this plot will be lost.
                    </div>

                    <div class="card bg-light border-0 p-3 mb-4">
                        <dl class="row mb-0">
                            <dt class="col-sm-4 text-muted">Cycle / Season:</dt>
                            <dd class="col-sm-8 fw-bold fs-5 text-danger">@Model.SeasonYear</dd>

                            <dt class="col-sm-4 text-muted">Field / Plot:</dt>
                            <dd class="col-sm-8">@Model.Field?.PlotName</dd>

                            <dt class="col-sm-4 text-muted">Planted Crop:</dt>
                            <dd class="col-sm-8">@Model.Crop?.CropName (@Model.Crop?.Family)</dd>

                            <dt class="col-sm-4 text-muted">Planting Date:</dt>
                            <dd class="col-sm-8">@Model.PlantingDate.ToString("dd MMM yyyy")</dd>

                            <dt class="col-sm-4 text-muted">Harvest Date:</dt>
                            <dd class="col-sm-8">@Model.ExpectedHarvestDate.ToString("dd MMM yyyy")</dd>

                            <dt class="col-sm-4 text-muted">Status:</dt>
                            <dd class="col-sm-8"><span class="badge bg-secondary">@Model.Status</span></dd>
                        </dl>
                    </div>

                    <form asp-action="Delete" method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" asp-for="Id" />
                        <div class="d-flex justify-content-between align-items-center">
                            <button type="submit" class="btn btn-danger px-4 fw-bold">Yes, Delete Cycle</button>
                            <a asp-action="Index" class="btn btn-outline-secondary">Cancel &amp; Return</a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
