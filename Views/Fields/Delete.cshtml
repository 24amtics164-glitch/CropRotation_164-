@model CropRotation_164.Models.Field
@{
    ViewData["Title"] = "Delete Field Plot";
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="card shadow-sm border-0 border-top border-4 border-danger bg-white">
                <div class="card-header bg-danger text-white py-3">
                    <h4 class="mb-0 fw-bold">⚠ Confirm Field Deletion</h4>
                </div>
                <div class="card-body p-4">
                    <div class="alert alert-warning mb-4" role="alert">
                        <strong>Caution:</strong> Deleting this field will permanently remove all associated crop rotation schedules recorded for it!
                    </div>

                    <div class="card bg-light border-0 p-3 mb-4">
                        <dl class="row mb-0">
                            <dt class="col-sm-4 text-muted">Plot Name:</dt>
                            <dd class="col-sm-8 fw-bold fs-5 text-danger">@Model.PlotName</dd>

                            <dt class="col-sm-4 text-muted">Area:</dt>
                            <dd class="col-sm-8">@Model.AreaInAcres.ToString("0.0") Acres</dd>

                            <dt class="col-sm-4 text-muted">Soil Type:</dt>
                            <dd class="col-sm-8">@Model.SoilType</dd>

                            <dt class="col-sm-4 text-muted">Location:</dt>
                            <dd class="col-sm-8">@Model.Location</dd>

                            <dt class="col-sm-4 text-muted">Associated Cycles:</dt>
                            <dd class="col-sm-8"><span class="badge bg-secondary">@Model.RotationPlans.Count rotation records</span></dd>
                        </dl>
                    </div>

                    <form asp-action="Delete" method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" asp-for="Id" />
                        <div class="d-flex justify-content-between align-items-center">
                            <button type="submit" class="btn btn-danger px-4 fw-bold">Yes, Delete Field</button>
                            <a asp-action="Index" class="btn btn-outline-secondary">Cancel &amp; Return</a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
