@model IEnumerable<CropRotation_164.Models.Field>
@{
    ViewData["Title"] = "Farm Fields & Plots";
}

<div class="container py-4">
    <!-- Header Card -->
    <div class="card shadow-sm border-0 mb-4 bg-agri rounded-3">
        <div class="card-body p-4 text-center">
            <h1 class="display-6 fw-bold mb-2">Farm Fields &amp; Plots Directory</h1>
            <p class="lead mb-0">Register and manage arable land sectors, soil profiles, and nutrient states</p>
        </div>
    </div>

    <!-- State Management Flash Notification -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show shadow-sm mb-4" role="alert">
            <span class="fs-5 me-2">✓</span> @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show shadow-sm mb-4" role="alert">
            <span class="fs-5 me-2">⚠</span> @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- Toolbar: Search Bar & Add Button -->
    <div class="card shadow-sm border-0 mb-4 bg-white">
        <div class="card-body">
            <div class="row g-3 align-items-center justify-content-between">
                <div class="col-md-6">
                    <form asp-action="Index" method="get" class="d-flex gap-2">
                        <input type="text" name="search" value="@ViewBag.CurrentSearch" class="form-control" placeholder="Search by plot name, soil type, location..." />
                        <button type="submit" class="btn btn-outline-success px-3">Search</button>
                        @if (!string.IsNullOrEmpty(ViewBag.CurrentSearch as string))
                        {
                            <a asp-action="Index" class="btn btn-outline-secondary">Clear</a>
                        }
                    </form>
                </div>
                <div class="col-md-auto text-end">
                    <a asp-action="Create" class="btn btn-agri fw-bold px-4">
                        + Register New Field Plot
                    </a>
                </div>
            </div>
        </div>
    </div>

    <!-- Fields Table -->
    <div class="card shadow-sm border-0 bg-white">
        <div class="card-header bg-dark text-white py-3 d-flex justify-content-between align-items-center">
            <h5 class="mb-0 fw-bold">Active Farm Sectors (@Model.Count() registered)</h5>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0 text-center">
                    <thead class="table-light">
                        <tr>
                            <th>ID</th>
                            <th class="text-start">Plot Name</th>
                            <th>Soil Type</th>
                            <th>Area (Acres)</th>
                            <th class="text-start">Location</th>
                            <th>Nutrient Status</th>
                            <th>Active Rotations</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (!Model.Any())
                        {
                            <tr>
                                <td colspan="8" class="py-5 text-muted">
                                    <p class="fs-5 mb-1">No farm plots found.</p>
                                    <a asp-action="Create" class="btn btn-agri btn-sm mt-2">Add Your First Field</a>
                                </td>
                            </tr>
                        }
                        else
                        {
                            foreach (var field in Model)
                            {
                                <tr>
                                    <td class="fw-bold">@field.Id</td>
                                    <td class="text-start">
                                        <a asp-action="Details" asp-route-id="@field.Id" class="fw-bold text-decoration-none text-agri fs-6">
                                            @field.PlotName
                                        </a>
                                    </td>
                                    <td>
                                        <span class="badge bg-secondary">@field.SoilType</span>
                                    </td>
                                    <td>
                                        <span class="badge bg-light text-dark border">@field.AreaInAcres.ToString("0.0") Ac</span>
                                    </td>
                                    <td class="text-start small text-muted">@field.Location</td>
                                    <td>
                                        <span class="badge bg-success bg-opacity-10 text-success border border-success">
                                            @field.CurrentNutrientStatus
                                        </span>
                                    </td>
                                    <td>
                                        <span class="badge bg-primary">
                                            @field.RotationPlans.Count cycles
                                        </span>
                                    </td>
                                    <td>
                                        <div class="btn-group btn-group-sm">
                                            <a asp-action="Details" asp-route-id="@field.Id" class="btn btn-outline-info" title="View Details">Details</a>
                                            <a asp-action="Edit" asp-route-id="@field.Id" class="btn btn-outline-warning" title="Edit Field">Edit</a>
                                            <a asp-action="Delete" asp-route-id="@field.Id" class="btn btn-outline-danger" title="Delete Field">Delete</a>
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
